    {
      "parameters": {
        "jsCode": "const chatId = String($('📩 Telegram Trigger').item.json.message.chat.id);\nconst content = String($('📩 Telegram Trigger').item.json.message.text);\n\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://rdvunzanykjjslumxtgu.supabase.co/rest/v1/messages',\n  headers: {\n    'Authorization': 'Bearer YOUR_SUPABASE_SERVICE_KEY',\n    'apikey': 'YOUR_SUPABASE_SERVICE_KEY',\n    'Content-Type': 'application/json'\n  },\n  body: {chat_id: chatId, role: 'user', content: content}\n});\n\nreturn [{json: {done: true}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2064,
        384
      ],
      "id": "06df7352-f902-40dd-ad00-9730834498f3",
      "name": "💾 Save User Message",
      "notes": "Purpose: Inserts current user message into Supabase before calling Groq\nTable: messages\nRole: user\nContent: message.text from Telegram Trigger"
    },
    {
      "parameters": {
        "jsCode": "const history = $('📂 Load History').all()\n  .map(i => ({\n    role: i.json.role,\n    content: i.json.content\n  }))\n  .filter(m => m.role && m.content && m.content.trim() !== '');\nconst messages = [\n  {role: \"system\", content: `You are a professional AI assistant for a business in Baku, Azerbaijan. \nYour job is to answer customer questions clearly and concisely.\nAlways respond in the same language the user writes in.\nNever make up information you are not sure about.\nKeep responses short and professional.`},\n  ...history,\n  {role: \"user\", content: String($('📩 Telegram Trigger').item.json.message.text)}\n];\n\nreturn [{json: {messages}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        480
      ],
      "id": "592329e8-0981-4104-ad3a-773ec3f26a45",
