      "alwaysOutputData": true,
      "notes": "Purpose: Formats full conversation history into Groq-compatible array\nStructure: [{role, content}, {role, content}...]\nIncludes: system prompt + loaded history + current message\nAlways Output Data: ON (handles empty history case)"
    },
    {
      "parameters": {
        "jsCode": "const content = $input.item.json.choices[0].message.content;\nconst cleaned = content.replace(/[\\u0000-\\u001F\\u007F]/g, ' ');\nreturn [{json: {cleaned_content: cleaned}}];"
      },
