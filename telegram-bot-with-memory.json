      "notes": "Purpose: Extracts plain text from Groq API response\nInput: choices[0].message.content\nOutput: Clean string passed to Save AI Message and Send Message"
    },
    {
      "parameters": {
        "jsCode": "const chatId = String($('📩 Telegram Trigger').item.json.message.chat.id);\nconst content = String($('✂️ Clean Response').item.json.cleaned_content);\n\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://rdvunzanykjjslumxtgu.supabase.co/rest/v1/messages',\n  headers: {\n    'Authorization': 'Bearer YOUR_SUPABASE_SERVICE_KEY',\n    'apikey': 'YOUR_SUPABASE_SERVICE_KEY',\n    'Content-Type': 'application/json'\n  },\n  body: {chat_id: chatId, role: 'assistant', content: content}\n});\n\nreturn [{json: {done: true}}];"
